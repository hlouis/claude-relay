{
  "name": "@hlouis/clay",
  "version": "2.12.0-beta.1",
  "description": "Web UI for Claude Code. Any device. Push notifications.",
  "bin": {
    "clay": "bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js --dev",
    "dev:isolated": "bash scripts/dev-isolated.sh",
    "dev:isolated:stop": "bash scripts/dev-isolated.sh --shutdown",
    "dev:isolated:clean": "bash scripts/dev-isolated.sh --clean",
    "test": "node --test test/agent-backend.test.js test/codex-jsonrpc.test.js test/codex-approval.test.js",
    "test:e2e": "node scripts/codex-e2e.js",
    "test:e2e:ui": "node scripts/codex-ui-e2e.js --headless",
    "test:e2e:auth-card": "node scripts/codex-auth-card-e2e.js --headless",
    "test:e2e:approval": "node scripts/codex-approval-ui-e2e.js --headless",
    "test:e2e:hide": "node scripts/codex-hide-ui-e2e.js --headless",
    "verify:approval-live": "node scripts/codex-approval-live-verify.js",
    "semantic-release": "semantic-release"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "mobile",
    "remote",
    "relay",
    "web-ui",
    "tailscale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlouis/claude-relay.git"
  },
  "bugs": {
    "url": "https://github.com/hlouis/claude-relay/issues"
  },
  "homepage": "https://github.com/hlouis/claude-relay#readme",
  "author": "Louis Huang <hlouis@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.128",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "nodemailer": "^6.10.1",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "playwright": "^1.59.1",
    "semantic-release": "^25.0.3"
  }
}
